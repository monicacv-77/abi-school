# Your Anthropic API key (from console.anthropic.com). Add it in Vercel → Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Passcode to open the app (Abi and you).
APP_PASSCODE=

# Separate PIN for the parent dashboard.
PARENT_PIN=

# Added automatically when the Vercel Blob store is connected. Leave empty locally to save to .data/ instead.
BLOB_READ_WRITE_TOKEN=

# Optional: override the model. Defaults to claude-sonnet-5-5.
ABI_MODEL=
